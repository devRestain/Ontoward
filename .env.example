# Local development only. Copy to the project root .env and enter your own key.
# Submission settings live separately in submission/.env and are packaged.
NOVA_API_BASE=https://nova.snubhai.org
NOVA_DEV_KEY=
NOVA_GUIDELINES_DIR=/workspace/assets/guidelines
# Explicit local Test OpenAI route only; never packaged or passed to the submission agent.
OPENAI_API_KEY=
TEST_OPENAI_MODEL=gpt-6-luna
