# Local credentials; the submission .env contains only approved public settings.
.env
.env.*
!.env.example
!/submission/.env
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.DS_Store
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.log
*.zip
*.tar
*.tar.gz
*.tgz
*.sqlite3.gz
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Keep directory guidance while excluding disposable outputs.
/Tmp/*
!/Tmp/AGENTS.md
!/Tmp/README.md
!/Tmp/snomed/
/Tmp/snomed/*
!/Tmp/snomed/README.md

# Preserve organizer originals locally; version curated reference and contracts.
/assets/*
