# Interrupted snapshots stay local even when they contain ordinary report names.
/data/preparation/**/interrupted-preview-*/**
# Shared catalog evidence is preparation data rather than a compact receipt.
/data/preparation/**/catalog/**

# Runtime Turtle and Korean JSON under submission/knowledge remain versioned.

