!/assets/bodhi/README.md

# Preparation databases, catalogs, worksets, request ledgers, and snapshots stay local.
# Version compact custody, approval, and verification records beside their builds.
/data/preparation/**
!/data/preparation/**/
!/data/preparation/**/README.md
!/data/preparation/**/report.json
!/data/preparation/**/*verification.json
!/data/preparation/**/admission.json
!/data/preparation/**/review-approved.json
!/data/preparation/**/workset-identity.json
!/data/preparation/**/evidence.json
!/data/preparation/**/evidence-files.json
!/data/preparation/**/code-custody.json
!/data/preparation/**/execution-environment.json
!/data/preparation/**/execution-summary.json
!/data/preparation/**/handoff-verification.json
!/data/preparation/**/storage-compaction.json
!/data/preparation/**/rehearsal-retirement.json
!/data/preparation/**/candidate-workflow.json
!/data/preparation/**/reset.json
!/data/preparation/**/deletion-receipt.json
!/data/preparation/**/connections.json
!/data/preparation/**/packaging.json
!/data/preparation/**/text-assets.json
