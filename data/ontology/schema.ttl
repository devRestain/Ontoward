@prefix ow: <urn:ontoward:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ow:Disease a rdfs:Class ;
    rdfs:label "질환"@ko, "Disease"@en ;
    rdfs:comment "A diagnosis concept that may become a candidate; graph membership does not establish a diagnosis."@en .

ow:Symptom a rdfs:Class ;
    rdfs:label "증상"@ko, "Symptom"@en ;
    rdfs:comment "A patient-reportable clinical complaint, including commonly named site- or activity-specific pain symptoms; preserve finer location, laterality, and other qualifiers as attributes."@en .

ow:FindingAttribute a rdfs:Class ;
    rdfs:label "소견 속성"@ko, "Finding attribute"@en ;
    rdfs:comment "A dimension used to characterize a Symptom or ExamFinding; exact numerical, temporal, and free-text values remain in case state."@en .

ow:AttributeValue a rdfs:Class ;
    rdfs:label "범주형 속성 값"@ko, "Attribute value"@en ;
    rdfs:comment "A reusable categorical value; location values are flat and do not imply geographical containment."@en .

ow:BodySystem a rdfs:Class ;
    rdfs:label "문진 계통"@ko, "Body system"@en ;
    rdfs:comment "A nonexclusive interview and ROS grouping; never a disease-candidate filter."@en .

ow:ContextFactor a rdfs:Class ;
    rdfs:label "맥락 요인"@ko, "Context factor"@en ;
    rdfs:comment "A history, exposure, or demographic concept; its patient-specific subject and context remain in case state."@en .

ow:ExamFinding a rdfs:Class ;
    rdfs:label "신체진찰 소견"@ko, "Examination finding"@en ;
    rdfs:comment "A finding obtainable through a physical examination, distinct from patient-reported symptoms."@en .

ow:ClinicalFeature a rdfs:Class ;
    rdfs:label "임상 특징"@ko, "Clinical feature"@en ;
    rdfs:comment "One atomic condition inheriting the target of its owning ClinicalPattern; no direct targets edge. Expected status and manually reviewed clinical role are optional."@en .

ow:ClinicalPattern a rdfs:Class ;
    rdfs:label "임상 패턴"@ko, "Clinical pattern"@en ;
    rdfs:comment "A profile owned by exactly one disease and targeting exactly one Symptom or ExamFinding, with zero or more features. A disease may have alternative symptom-targeted profiles. Partial matching is allowed; membership does not assert a conjunction or multi-finding syndrome."@en .

ow:ExamMethod a rdfs:Class ;
    rdfs:label "신체진찰 방법"@ko, "Examination method"@en ;
    rdfs:comment "A concrete physical-examination maneuver identified by its URI and mapped to a suggested SDK EXAM text request."@en .

ow:Test a rdfs:Class ;
    rdfs:label "검사 계획 대상"@ko, "Test"@en ;
    rdfs:comment "An investigation concept used only for SOAP P.tests; excluded from current diagnostic reasoning and action selection."@en .

ow:hasAttribute a rdf:Property ;
    rdfs:range ow:FindingAttribute ;
    rdfs:comment "Identifies an attribute applicable to a Symptom or ExamFinding; validate this subject disjunction explicitly rather than declaring multiple RDFS domains."@en .

ow:canHaveValue a rdf:Property ;
    rdfs:domain ow:FindingAttribute ;
    rdfs:range ow:AttributeValue ;
    rdfs:comment "Enumerates admitted categorical values; not required for continuous or free-text case values."@en .

ow:inSystem a rdf:Property ;
    rdfs:domain ow:Symptom ;
    rdfs:range ow:BodySystem ;
    rdfs:comment "Classifies a symptom for interview discovery without restricting disease recall."@en .

ow:presentsAs a rdf:Property ;
    rdfs:domain ow:Disease ;
    rdfs:range ow:Symptom ;
    rdfs:comment "Optional presentation relation retained in the vocabulary; v4.2 candidate retrieval uses hasPattern and targets without requiring this redundant edge."@en .

ow:hasPattern a rdf:Property ;
    rdfs:domain ow:Disease ;
    rdfs:range ow:ClinicalPattern ;
    rdfs:comment "Associates a disease with its own patterns; each admitted pattern has exactly one owning disease. Alternative presentation patterns provide independent retrieval paths without requiring every pattern to match."@en .

ow:hasFeature a rdf:Property ;
    rdfs:domain ow:ClinicalPattern ;
    rdfs:range ow:ClinicalFeature ;
    rdfs:comment "Lists zero or more pattern-local features for partial matching; each admitted feature has exactly one owning pattern."@en .

ow:targets a rdf:Property ;
    rdfs:domain ow:ClinicalPattern ;
    rdfs:comment "Targets exactly one Symptom or ExamFinding; the disjunction is validated explicitly, not by multiple rdfs:range declarations."@en .

ow:onAttribute a rdf:Property ;
    rdfs:domain ow:ClinicalFeature ;
    rdfs:range ow:FindingAttribute ;
    rdfs:comment "Qualifies the owning pattern's Symptom or ExamFinding target; occurs exactly once with expectsValue or is omitted with it for a status-only condition."@en .

ow:expectsValue a rdf:Property ;
    rdfs:domain ow:ClinicalFeature ;
    rdfs:range ow:AttributeValue ;
    rdfs:comment "Specifies one categorical expected value admitted by the paired attribute; actual observations remain outside this graph."@en .

ow:hasSupportingContext a rdf:Property ;
    rdfs:domain ow:Disease ;
    rdfs:range ow:ContextFactor ;
    rdfs:comment "Supports an already retrieved disease only; context is outside patterns, does not create candidates, and is not negative evidence when absent or unknown."@en .

ow:detectedBy a rdf:Property ;
    rdfs:domain ow:ExamFinding ;
    rdfs:range ow:ExamMethod ;
    rdfs:comment "States how a finding can be elicited; an admitted finding requires at least one method and no result is implied."@en .

ow:evaluatedBy a rdf:Property ;
    rdfs:domain ow:Disease ;
    rdfs:range ow:Test ;
    rdfs:comment "Provides a test-planning association for SOAP P.tests only; never used for current diagnosis matching or TEST execution."@en .

ow:expectedStatus a rdf:Property ;
    rdfs:domain ow:ClinicalFeature ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional present | absent expectation scoped to the owning pattern's target and any qualifier; at most one value. Omission supplies no presence or absence condition."@en .

ow:clinicalRole a rdf:Property ;
    rdfs:domain ow:ClinicalFeature ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional manually reviewed supportive | characteristic | opposing role relative to the owning disease; at most one value. Unassigned is not low importance, and expected absence is not an opposing role."@en .

ow:importance a rdf:Property ;
    rdfs:domain ow:ClinicalPattern ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional manually reviewed characteristic designation; at most one value, independent of feature clinicalRole. Omission is unassigned, not low importance. Selectivity is deferred to post-build work."@en .

ow:contextType a rdf:Property ;
    rdfs:domain ow:ContextFactor ;
    rdfs:range xsd:string ;
    rdfs:comment "past_medical_history | surgical_history | medication_history | allergy_history | family_history | social_history | occupational_history | psychosocial_history | screening_history | demographic; exactly one category per admitted factor."@en .

ow:urgencyLabel a rdf:Property ;
    rdfs:domain ow:Disease ;
    rdfs:range xsd:string ;
    rdfs:comment "Optional descriptive documentation metadata without priority, branching, or automated triage semantics."@en .

ow:examRequestText a rdf:Property ;
    rdfs:domain ow:ExamMethod ;
    rdfs:range xsd:string ;
    rdfs:comment "Exactly one plain xsd:string containing a concrete Korean examination request; NFC-normalized length 1–30 code points. A suggested payload, not proven server support."@en .
