ow:Dizziness a ow:Symptom ;
    rdfs:label "어지럼"@ko, "Dizziness"@en ;
    skos:altLabel "어지러움"@ko ;
    ow:inSystem ow:Nervous ;
    ow:hasAttribute ow:Onset, ow:Course, ow:EpisodeDuration, ow:Frequency, ow:Timing, ow:Severity, ow:Trigger, ow:AggravatingFactor, ow:RelievingFactor .

ow:Location a ow:FindingAttribute ;
    rdfs:label "위치"@ko, "Location"@en ;
    ow:canHaveValue ow:Head, ow:Forehead, ow:Temple, ow:Occiput, ow:Face, ow:Eye, ow:Ear, ow:Nose, ow:Mouth, ow:Throat, ow:Neck, ow:Chest, ow:SternalRegion, ow:LateralChest, ow:Abdomen, ow:Epigastrium, ow:PeriumbilicalRegion, ow:RightUpperQuadrant, ow:LeftUpperQuadrant, ow:RightLowerQuadrant, ow:LeftLowerQuadrant, ow:SuprapubicRegion, ow:Flank, ow:Back, ow:UpperBack, ow:LowerBack, ow:Pelvis, ow:Groin, ow:Perineum, ow:Shoulder, ow:UpperArm, ow:Elbow, ow:Forearm, ow:Wrist, ow:Hand, ow:Finger, ow:Hip, ow:Thigh, ow:Knee, ow:LowerLeg, ow:Calf, ow:Ankle, ow:Foot, ow:Toe, ow:WholeBody .

ow:Laterality a ow:FindingAttribute ;
    rdfs:label "좌우 구분"@ko, "Laterality"@en ;
    ow:canHaveValue ow:Left, ow:Right, ow:Bilateral, ow:Midline .

ow:Quality a ow:FindingAttribute ;
    rdfs:label "양상"@ko, "Quality"@en ;
    ow:canHaveValue ow:PressureLike, ow:Squeezing, ow:Burning, ow:Stabbing, ow:Dull, ow:Aching, ow:Cramping, ow:Throbbing ;
    rdfs:comment "The starter values describe specific pain symptoms; add other symptom qualities only after reviewing their meaning."@en .

ow:Onset a ow:FindingAttribute ;
    rdfs:label "발현"@ko, "Onset"@en ;
    ow:canHaveValue ow:Sudden, ow:Gradual .

ow:Course a ow:FindingAttribute ;
    rdfs:label "경과"@ko, "Course"@en ;
    ow:canHaveValue ow:Continuous, ow:Intermittent, ow:Progressive, ow:Improving .

ow:EpisodeDuration a ow:FindingAttribute ;
    rdfs:label "한 에피소드의 지속 시간"@ko, "Episode duration"@en ;
    rdfs:comment "Exact quantities and units remain in case state; no duration or frequency thresholds are defined here."@en .

ow:Frequency a ow:FindingAttribute ;
    rdfs:label "빈도"@ko, "Frequency"@en ;
    rdfs:comment "Exact quantities and units remain in case state; no duration or frequency thresholds are defined here."@en .

ow:Timing a ow:FindingAttribute ;
    rdfs:label "발생 시간대"@ko, "Timing"@en ;
    ow:canHaveValue ow:Morning, ow:Daytime, ow:Evening, ow:Nighttime .

ow:Severity a ow:FindingAttribute ;
    rdfs:label "정도"@ko, "Severity"@en ;
    ow:canHaveValue ow:Mild, ow:Moderate, ow:Severe ;
    rdfs:comment "Use these categories only when explicitly reported; do not convert NRS or other numbers using implicit cutoffs."@en .

ow:Trigger a ow:FindingAttribute ;
    rdfs:label "유발 요인"@ko, "Trigger"@en ;
    ow:canHaveValue ow:Exertion, ow:Meals, ow:Breathing, ow:Coughing, ow:Movement, ow:PositionChange, ow:Rest .

ow:AggravatingFactor a ow:FindingAttribute ;
    rdfs:label "악화 요인"@ko, "Aggravating factor"@en ;
    ow:canHaveValue ow:Exertion, ow:Meals, ow:Breathing, ow:Coughing, ow:Movement, ow:PositionChange, ow:Rest .

ow:RelievingFactor a ow:FindingAttribute ;
    rdfs:label "완화 요인"@ko, "Relieving factor"@en ;
    ow:canHaveValue ow:Exertion, ow:Meals, ow:Breathing, ow:Coughing, ow:Movement, ow:PositionChange, ow:Rest .

ow:Radiation a ow:FindingAttribute ;
    rdfs:label "방사 부위"@ko, "Radiation"@en ;
    ow:canHaveValue ow:Head, ow:Forehead, ow:Temple, ow:Occiput, ow:Face, ow:Eye, ow:Ear, ow:Nose, ow:Mouth, ow:Throat, ow:Neck, ow:Chest, ow:SternalRegion, ow:LateralChest, ow:Abdomen, ow:Epigastrium, ow:PeriumbilicalRegion, ow:RightUpperQuadrant, ow:LeftUpperQuadrant, ow:RightLowerQuadrant, ow:LeftLowerQuadrant, ow:SuprapubicRegion, ow:Flank, ow:Back, ow:UpperBack, ow:LowerBack, ow:Pelvis, ow:Groin, ow:Perineum, ow:Shoulder, ow:UpperArm, ow:Elbow, ow:Forearm, ow:Wrist, ow:Hand, ow:Finger, ow:Hip, ow:Thigh, ow:Knee, ow:LowerLeg, ow:Calf, ow:Ankle, ow:Foot, ow:Toe, ow:WholeBody .

