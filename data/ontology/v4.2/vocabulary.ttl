ow:Anxiety a ow:Symptom ;
    rdfs:label "불안감"@ko, "Anxiety"@en ;
    ow:inSystem ow:Psychiatric ;
    ow:hasAttribute ow:Onset, ow:Course, ow:EpisodeDuration, ow:Frequency, ow:Timing, ow:Severity, ow:Trigger, ow:AggravatingFactor, ow:RelievingFactor ;
    rdfs:comment "Reported anxiety as a symptom, not a diagnosis of an anxiety disorder."@en .

ow:Depression a ow:Symptom ;
    rdfs:label "우울감"@ko, "Depressed mood"@en ;
    ow:inSystem ow:Psychiatric ;
    ow:hasAttribute ow:Onset, ow:Course, ow:EpisodeDuration, ow:Frequency, ow:Timing, ow:Severity, ow:Trigger, ow:AggravatingFactor, ow:RelievingFactor ;
    rdfs:comment "Depressed mood as a reported symptom, not a diagnosis of depressive disorder."@en .

ow:Insomnia a ow:Symptom ;
